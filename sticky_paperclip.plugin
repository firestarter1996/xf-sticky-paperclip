__id__ = "sticky_paperclip"
__name__ = "Sticky Paperclip"
__description__ = "Keeps the paperclip (attach files and photos) button in the message field while you type, so you can add a file after writing your text. The text stays clear of the button. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.0.0"
__min_version__ = "12.5.1"

# Nagram's attach menu in the input mode (on by default) hides the paperclip as soon as the field has
# text: checkSendButton() calls checkAttachButton(true, ...), which sets the button GONE, and fades
# it out together with the bot, silent and scheduled buttons next to it. The Java part (embedded
# below) turns that hide call into stock's own "keep shown" path (same click, same icon, and the
# field keeps its 50 dp right margin so the text never runs under the button) and takes the
# paperclip out of the fade, while the row next to it still fades away as before. It acts only when
# stock was about to hide the button: no polling, no redraws, nothing per keystroke beyond two cheap
# hook calls. Logcat tag XFClip (errors only).

import base64
import zlib

from java import jclass
from base_plugin import BasePlugin
from ui.settings import Header, Text

ENTRY = "com.firestarter.xfclip.StickyClip"


def _log(msg):
    try:
        jclass("android.util.Log").i("XFClip", str(msg))
    except Exception:
        pass


class StickyPaperclipPlugin(BasePlugin):

    def create_settings(self):
        st = "not running"
        try:
            if self.core is not None:
                st = str(self.core.getMethod("stats").invoke(None))
        except Exception:
            pass
        return [Header(text="Sticky Paperclip"), Text(text="Status", subtext=st)]

    def on_plugin_load(self):
        self.core = None
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            with open(__file__, "r", encoding="utf-8") as fh:
                text = fh.read()
            block = text.rsplit("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
            payload = "".join(l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#"))
            data = zlib.decompress(base64.b64decode(payload))
            Loader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = Loader(jclass("java.nio.ByteBuffer").wrap(data), ctx.getClassLoader())
            self.core = self.loader.loadClass(ENTRY)
            AU = jclass("org.telegram.messenger.AndroidUtilities")
            from android_utils import R
            self._r = R(lambda: _log("install %s: %s" % (__version__, self.core.getMethod("install", jclass("java.lang.ClassLoader")).invoke(None, ctx.getClassLoader()))))
            AU.runOnUIThread(self._r)
        except Exception as e:
            self.core = None
            _log("load: %s" % e)

    def on_plugin_unload(self):
        try:
            if self.core is not None:
                self.core.getMethod("uninstall").invoke(None)
                _log("uninstalled")
        except Exception as e:
            _log("unload: %s" % e)
        self.core = None

